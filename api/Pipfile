[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
django = ">=5.2,<6.0"
djangorestframework = ">=3.18.3,<4.0"
django-cors-headers = ">=4.6,<5.0"
mysqlclient = ">=2.3.0,<3.0"
gunicorn = ">=23.0,<26.0"
uvicorn = {extras = ["standard"], version = ">=0.54.0,<1.0"}
openai = ">=2.0,<3.0"
requests = ">=2.32,<3.0"
channels = ">=4.2,<5.0"
setuptools = ">=84.0.0,<85"
kani = {extras = ["openai", "anthropic"]}
anthropic = ">=0.40,<1.0"
asgiref = ">=3.8,<4.0"
python-dotenv = ">=1.0,<2.0"
django-redis = ">=7.0.0,<8.0"
whitenoise = ">=6.9,<7.0"
nltk = ">=3.9,<4.0"
certifi = ">=2025.0"
pillow = ">=11.0,<13.0"
boto3 = ">=1.43.111,<2.0"
django-import-export = ">=4.0,<5.0"
django-storages = {extras = ["s3"], version = ">=1.14,<4.0"}
# Transitive via Django, pinned up explicitly for security: everything at or
# below 0.5.5 carries five advisories — ReDoS and quadratic CPU blowups when
# parsing SQL, plus a string breakout in generated snippets. Django itself only
# asks for >=0.3.1, so without a floor here a re-lock can drop back to a
# vulnerable release. Enforced by test_dependency_security.py.
sqlparse = ">=0.6.0,<1.0"

[requires]
python_version = "3.12"

[dev-packages]
ruff = ">=0.17.0,<2.0"
# Capped below 9.0: pytest 9 changed fixture finalisation in a way
# pytest-asyncio 1.4.0 (the latest release) does not support — every async test
# errors at setup with `assert not self._finalizers`. Raise this cap only once
# pytest-asyncio ships a pytest 9 compatible release.
pytest = ">=8.0,<9.0"
pytest-django = ">=4.9,<5.0"
pytest-asyncio = ">=0.25,<2.0"
isort = ">=9.0.2,<10.0"
mypy = ">=2.4.0,<3.0"
black = ">=26.10.1,<27.0"
django-stubs = ">=6.1.2,<7.0"
